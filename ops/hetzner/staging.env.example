APP_ROOT=/opt/poshard/gufo-gestiune-staging
FRONTEND_URL=https://staging.gufo-pos.ro
API_URL=https://api-staging.gufo-pos.ro/health
DOMAIN_ALLOW_URL=https://api-staging.gufo-pos.ro/api/v1/public/domain-allow?domain=staging.gufo-pos.ro
LOGIN_PAGE_URL=https://staging.gufo-pos.ro/login
API_CONTAINER=gufo-gestiune-staging-api-1
FRONTEND_CONTAINER=gufo-gestiune-staging-frontend-1
WORKER_CONTAINER=gufo-gestiune-staging-worker-1
WORKER_HEARTBEAT_FILE=/opt/poshard/gufo-gestiune-staging/uploads/ops/worker-heartbeat.json
# If you want demo data in staging, enable intentionally in backend env:
# ENABLE_DEMO_SEED=true
# DEMO_SEED_PASSWORD=replace-with-staging-demo-password
